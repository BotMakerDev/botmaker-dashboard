<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      groupId matches the JitPack coordinate like every other module here, and unlike every other module
      that is a convention rather than a requirement: THIS ONE IS NOT ON JITPACK. It is an application, not
      a library — nothing resolves it, JitPack never builds it, and there is no tag whose name would
      override the version below.

      Since 2026-09-17 it IS released, as Studio is: a `v*` tag runs the `package` job in ci.yml, which
      builds a Linux rpm + deb through the `dist` profile below and publishes them as a GitHub Release.
      Two consequences, one omission kept and one added:

        * STILL NO flatten-maven-plugin. Flatten exists to bake a property-driven BotMaker upstream into
          the pom a CONSUMER downloads. This module has such properties (botmaker.shared.version,
          botmaker.cli.version) and no consumer, so there is no published pom for a -D to be missing from.
        * A .deps.env, like Studio's: the `package` job checks the four upstreams out at the refs it names
          and `mvn install`s them at 0.0.0-SNAPSHOT — the value the properties below default to — so the
          release build resolves them from source. The `dist` profile also bakes that file into the jar
          (META-INF/botmaker/.deps.env), which is how the installed app knows which cli it carries.
    -->
    <groupId>com.github.LiQiyeDev</groupId>
    <artifactId>botmaker-dashboard</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <name>BotMaker Dashboard</name>
    <description>
        The maintainer's window onto the release constellation: what each module's latest tag is and whether
        it has drifted, what the last releases did and whether their artifacts resolve, what a release would
        decide before it is cut, and the queue of plugin and bot submissions waiting on a verdict.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.4</javafx.version>
        <junit.version>5.10.2</junit.version>
        <jackson.version>2.17.0</jackson.version>
        <!-- The reactor/offline value. An umbrella `mvn install` resolves shared from the reactor; a
             standalone build here resolves the 0.0.0-SNAPSHOT a local `mvn -pl botmaker-shared install`
             leaves in ~/.m2. There is no released-tag injection because there is no published build. -->
        <botmaker.shared.version>0.0.0-SNAPSHOT</botmaker.shared.version>
        <botmaker.cli.version>0.0.0-SNAPSHOT</botmaker.cli.version>
        <!-- Numeric-only version for jpackage (it rejects -SNAPSHOT). The package job passes the tag's
             number as -Dapp.version; a local `-Pdist package` gets this placeholder. -->
        <app.version>1.0.0</app.version>
        <!-- jpackage's app icon: the desktop entry and the launcher, rasterized from
             src/main/resources/icons/icon.svg because jpackage cannot read SVG. Linux only here, so .png;
             Studio's pom overrides the same property per OS profile because Studio ships those. -->
        <installer.icon>${project.basedir}/src/main/resources/icons/icon.png</installer.icon>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          The list this module is NOT on is the interesting half: not botmaker-studio (an application cannot
          be depended on) and not the SDK. This module loads no plugin and opens no bot project — it reads
          git, GitHub and the umbrella's own files.

          What it wants from shared is com.botmaker.shared.github: the REST client, the OAuth device flow
          and GitHubConfig's repository names. That package moved out of Studio on 2026-09-05 for this
          module specifically.
        -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-shared</artifactId>
            <version>${botmaker.shared.version}</version>
        </dependency>

        <!--
          botmaker-cli's MAIN artifact, for one package: com.botmaker.cli.release — the port of release.sh's
          own decisions. It is here for the same reason the plugin registry's CI resolves the same artifact
          for com.botmaker.cli.validate: THE ANSWER SHOWN MUST BE THE ANSWER THE RELEASE WILL GIVE. This tab
          says "1.1.6 -> 1.2.0" beside a level, and computing that here from the module's latest tag would
          be a second implementation of resolve_version — the one thing CLAUDE.md forbids, discovered as a
          bad tag, which cannot be edited.

          The main artifact, never the `all` classifier: that one is the shaded executable and carries
          picocli. This module runs no command line. picocli does not arrive either way — the CLI declares
          it `optional`, which is exactly what makes "the library knows no command line" a fact about the
          dependency graph.

          The two exclusions keep the paragraph above honest. The CLI is a plugin HOST, so it pins the
          contract at compile scope and depends on plugin-host; this module hosts nothing and calls neither.
          Excluding them means the contract cannot arrive here by accident — and if com.botmaker.cli.release
          ever needs one of them, that is a compile error here rather than a silent new dependency edge.
        -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-cli</artifactId>
            <version>${botmaker.cli.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.github.LiQiyeDev</groupId>
                    <artifactId>botmaker-studio-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.LiQiyeDev</groupId>
                    <artifactId>botmaker-plugin-host</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Declared rather than inherited from shared: this module parses GitHub's JSON itself, and a
             dependency it names in its own source belongs in its own pom. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The release widgets are the first classes here that can only be checked by drawing them, so the
             module takes Studio's headless set: TestFX over Monocle's Headless platform, no display needed.
             Monocle 21.0.2 with JavaFX 25 is the pairing Studio already runs; jdk-12.0.1+2 lacks
             Window._updateViewSize and throws AbstractMethodError on stage.show(). -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>21.0.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Pinned for the same reason every module here pins it, even though this one never reaches
                 JitPack: one compiler version across the project, so a build failure is never "which
                 maven-compiler-plugin did this module get". 3.11.0 is the project-wide known-good.  -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>
                        --add-exports javafx.graphics/com.sun.glass.ui.monocle=ALL-UNNAMED
                        --add-opens javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
                        --add-opens javafx.graphics/com.sun.glass.ui.monocle=ALL-UNNAMED
                        --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                    </argLine>
                    <!-- Read when the FX toolkit starts, so they must be set before the first UI test boots it.
                         FxHeadless re-applies them for an IDE run that bypasses Surefire. -->
                    <systemPropertyVariables>
                        <testfx.robot>glass</testfx.robot>
                        <testfx.headless>true</testfx.headless>
                        <glass.platform>Monocle</glass.platform>
                        <monocle.platform>Headless</monocle.platform>
                        <prism.order>sw</prism.order>
                        <prism.text>t2k</prism.text>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- `mvn -pl botmaker-dashboard javafx:run` from the umbrella root. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.botmaker.dashboard.DashboardApp</mainClass>
                    <options>
                        <option>--enable-native-access=ALL-UNNAMED,javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>

            <!-- One executable jar, which is what jpackage wraps: Studio's shape. The main class is the
                 Launcher (it does not extend Application, so `java -jar` works with JavaFX on the
                 classpath). No native filters: this module ships no OpenCV, OCR or JNA. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.botmaker.dashboard.Launcher</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${app.version}</Implementation-Version>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          `dist` profile: the Linux installers, via jpackage — Studio's profile with everything Studio
          needs and this window does not taken out (no Windows leg, no javac/JDI modules, no .ico/.icns, no
          spec override). Run on Linux only; jpackage builds for the OS it runs on.

            mvn -Pdist package -Dapp.version=1.2.3
            -> target/dist/BotMaker Dashboard/   (the app-image)
            -> target/dist/*.rpm, *.deb

          Build it with an upstream JDK (Temurin, ~/.jdks): jlink from Fedora's patched java-25-openjdk
          refuses with "java.security has been modified" — see the note in botmaker-studio/pom.xml.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <!-- jpackage refuses to overwrite an existing app-image. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>clean-dist</id>
                                <phase>prepare-package</phase>
                                <goals><goal>clean</goal></goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/dist</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <!-- The module's .deps.env, into the jar: the installed app reads CLI_TAG out
                                 of it to say when the checkout's botmaker-cli has moved past the cli this
                                 build calls (umbrella/BuiltWith). Only under -Pdist, so a development run —
                                 whose cli IS the checkout's — has no resource and says nothing. -->
                            <execution>
                                <id>bake-deps-env</id>
                                <phase>generate-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/META-INF/botmaker</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}</directory>
                                            <includes>
                                                <include>.deps.env</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <!-- Only the shaded jar goes into jpackage's input directory. -->
                            <execution>
                                <id>stage-jpackage-input</id>
                                <phase>package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>build-app-image</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>APP_IMAGE</type>
                                    <name>BotMaker Dashboard</name>
                                    <appVersion>${app.version}</appVersion>
                                    <vendor>LiQiyeDev</vendor>
                                    <input>${project.build.directory}/jpackage-input</input>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>com.botmaker.dashboard.Launcher</mainClass>
                                    <javaOptions>
                                        <javaOption>--enable-native-access=ALL-UNNAMED,javafx.graphics</javaOption>
                                    </javaOptions>
                                    <!-- jlink from the run-time image (no <modulePaths>: JDK 25 ships no
                                         jmods — see Studio's pom). The root list is what a JavaFX window
                                         plus an HTTP client plus a git subprocess needs; the release child
                                         (ReleaseLauncher) is `java -cp` from this same runtime, so
                                         bin/java must survive — never add strip-native-commands. -->
                                    <addModules>
                                        <addModule>java.base</addModule>
                                        <addModule>java.desktop</addModule>
                                        <addModule>java.management</addModule>
                                        <addModule>java.net.http</addModule>
                                        <addModule>java.prefs</addModule>
                                        <addModule>java.scripting</addModule>
                                        <addModule>java.sql</addModule>
                                        <addModule>jdk.unsupported</addModule>
                                        <addModule>jdk.zipfs</addModule>
                                        <addModule>jdk.charsets</addModule>
                                        <addModule>jdk.crypto.ec</addModule>
                                        <addModule>jdk.localedata</addModule>
                                        <addModule>jdk.accessibility</addModule>
                                    </addModules>
                                    <jLinkOptions>
                                        <jLinkOption>--strip-debug</jLinkOption>
                                        <jLinkOption>--no-man-pages</jLinkOption>
                                        <jLinkOption>--no-header-files</jLinkOption>
                                        <jLinkOption>--compress=zip-0</jLinkOption>
                                    </jLinkOptions>
                                    <destination>${project.build.directory}/dist</destination>
                                    <!-- Baked into the app-image, so the two installers below must NOT
                                         repeat it: jpackage rejects an icon beside an <appImage>. -->
                                    <icon>${installer.icon}</icon>
                                </configuration>
                            </execution>

                            <!-- The two installers take the app-image above as input, so the runtime is
                                 linked once. Everything baked into the app-image must not be repeated here.
                                 The GUI stack is declared by hand for the reason Studio's pom gives: nothing
                                 in the package's own ELF payload links GTK, so autodetect finds nothing. -->
                            <execution>
                                <id>build-deb</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>DEB</type>
                                    <name>BotMaker Dashboard</name>
                                    <linuxPackageName>botmaker-dashboard</linuxPackageName>
                                    <appVersion>${app.version}</appVersion>
                                    <vendor>LiQiyeDev</vendor>
                                    <appImage>${project.build.directory}/dist/BotMaker Dashboard</appImage>
                                    <destination>${project.build.directory}/dist</destination>
                                    <additionalOptions>
                                        <option>--linux-package-deps</option>
                                        <option>libgtk-3-0t64 | libgtk-3-0, libx11-6, libxtst6, libxi6, libxxf86vm1, libgl1, libfontconfig1, git</option>
                                    </additionalOptions>
                                    <linuxShortcut>true</linuxShortcut>
                                    <linuxMenuGroup>Development</linuxMenuGroup>
                                    <linuxAppCategory>Development</linuxAppCategory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>build-rpm</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>RPM</type>
                                    <name>BotMaker Dashboard</name>
                                    <linuxPackageName>botmaker-dashboard</linuxPackageName>
                                    <appVersion>${app.version}</appVersion>
                                    <vendor>LiQiyeDev</vendor>
                                    <appImage>${project.build.directory}/dist/BotMaker Dashboard</appImage>
                                    <destination>${project.build.directory}/dist</destination>
                                    <!-- Soname capabilities, as Studio's rpm: built on ubuntu-latest, whose
                                         rpm has no ELF dependency generator, so Requires: is exactly this. -->
                                    <additionalOptions>
                                        <option>--linux-package-deps</option>
                                        <option>libgtk-3.so.0()(64bit), libX11.so.6()(64bit), libXtst.so.6()(64bit), libXi.so.6()(64bit), libXxf86vm.so.1()(64bit), libGL.so.1()(64bit), libfontconfig.so.1()(64bit), git</option>
                                    </additionalOptions>
                                    <linuxShortcut>true</linuxShortcut>
                                    <linuxMenuGroup>Development</linuxMenuGroup>
                                    <linuxAppCategory>Development</linuxAppCategory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
